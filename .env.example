# Supabase (optional: without these the service reads the CSVs in data/)
#   SUPABASE_URL: Project Settings > API > Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Project Settings > API Keys > service_role (or a secret key, sb_secret_...)
#   SUPABASE_DB_URL: Connect > Session pooler connection string (lets ./run.sh create the tables)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# OpenRouter (optional: without a key the service uses the code choice)
OPENROUTER_API_KEY=
# Leave empty for the free default (nvidia/nemotron-3-ultra-550b-a55b:free)
OPENROUTER_MODEL=

# Date the rebooking request is made (routing check R1). Empty = today.
# After 23 Nov 2026 every booking goes to Revenue Management, so the demo uses 2026-11-18.
REQUEST_DATE=2026-11-18
